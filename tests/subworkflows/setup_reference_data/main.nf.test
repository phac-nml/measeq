nextflow_workflow {

    name "Test of Reference Setup Subworkflow with Optional Params"
    script "subworkflows/local/setup_reference_data/main.nf"
    workflow "SETUP_REFERENCE_DATA"
    tag "subworkflows"
    tag "reference"

    setup {
        run("NEXTCLADE_DATASETGET") {
            script "modules/nf-core/nextclade/datasetget/main.nf"
            process {
                """
                input[0] = 'nextstrain/measles/N450/WHO-2012'
                input[1] = '2025-03-26--11-47-13Z'

                """
            }
        }
    }


    test("Reference Setup Workflow with Optional") {
        tag "success"
        when {
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [id: "SRR7517490", single_end: false],
                        [
                            file("$baseDir/test_data/illumina_fastqs/SRR7517490_R1.fastq.gz"),
                            file("$baseDir/test_data/illumina_fastqs/SRR7517490_R2.fastq.gz")
                        ]
                    ]
                )
                input[1] = NEXTCLADE_DATASETGET.out.dataset
                """
            }
            params {
                outdir = "results"
                amplicon = true
            }
        }
        then {
            assertAll(
                { assert workflow.success }
            )

            // Files exist
            // Reference Intermediates
            assert path("${launchDir}/results/reference/MH356245.1.genome.bed").exists()
            assert path("${launchDir}/results/reference/MH356245.1.amplicon.bed").exists()
            assert path("${launchDir}/results/reference/MH356245.1.refstats.txt").exists()
            assert path("${launchDir}/results/reference/MH356245.1.reference.fasta.fai").exists()
            // Amplicon Regions
            assert path("${launchDir}/results/reference/amplicon_regions/1.MH356245.1.bed").exists()
            assert path("${launchDir}/results/reference/amplicon_regions/2.MH356245.1.bed").exists()
        }
    }
}
