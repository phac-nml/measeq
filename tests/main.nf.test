            assert iridanext_metadata.sample1.qc_status == "PASS"

            assert iridanext_metadata.sample2.genotype == "NA"
            assert iridanext_metadata.sample2.reference == "MK513622.1"
            assert iridanext_metadata.sample2.matched_dsid == "No Data"
            assert iridanext_metadata.sample2.num_input_reads == "5171"
            assert iridanext_metadata.sample2.num_aligned_reads == "664"
            assert iridanext_metadata.sample2.num_consensus_n == "14581"
            assert iridanext_metadata.sample2.genome_completeness_percent == "7.0"
            assert iridanext_metadata.sample2.mean_sequencing_depth == "21.75"
            assert iridanext_metadata.sample2.median_sequencing_depth == "0.0"
            assert iridanext_metadata.sample2.total_variants == "4"
            assert iridanext_metadata.sample2.num_snps == "4"
            assert iridanext_metadata.sample2.num_masked == "31"
            assert iridanext_metadata.sample2.genome_length == "15678"
            assert iridanext_metadata.sample2.divisible_by_6 == "PASS"
            assert iridanext_metadata.sample2.N450_completeness == "0.0"
            assert iridanext_metadata.sample2.N450_mean_depth == "0.0"
            assert iridanext_metadata.sample2.N450_status == "FAIL"
            assert iridanext_metadata.sample2.qc_status == "INCOMPLETE_GENOME"


            // Pipeline info and tracking
            assert path("$launchDir/results/pipeline_info").exists()
            assert path("$launchDir/results/pipeline_info/measeq_software_mqc_versions.yml").exists()
        }
    }
}
